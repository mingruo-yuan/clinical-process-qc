 "诊断 (tbl_dia_all_diagnoses)": {
  "出院诊断": "喉鳞状细胞癌（声门上型pT2N3bM0 IVB期）",
  "入院诊断": "喉鳞状细胞癌（声门上型cT1N3M0）"
 },
 "出院记录": {
  "出院情况": "患者目前生命体征平稳，佩戴9mm金属管，呼吸通畅，一般情况良好，体温波动正常，诉颈部无明显疼痛，进食半流质饮食无异常，进水无呛咳，颈部引流管已拔除，颈前刀口已经拆线，准予出院。",
  "出院医嘱": "1. 气管切开护理，保持刀口清洁；2. 术后鼻饲流质饮食2周后可经口试进食；3. 建议术后1月左右行颈部放疗；4. 每3个月门诊复查，复查请携带病历复印件（在1F病员服务中心复印病历），如有不适，随诊。"
 },
 "入院记录": {
  "主诉": "发现颈部肿物5月余。",
  "现病史": "患者5月余前无明显诱因发现左侧颈部肿物，无声音嘶哑，无咽痛、进食饮水呛咳，无吞咽阻挡感，无呼吸困难，就诊于外院，喉镜检查会厌喉面粗糙肿物待查，活检病理示会厌活检：考虑鳞状细胞癌，待免疫组化确诊。今为求进一步治疗于我院就诊，门诊以喉恶性肿瘤收入我科。患者自发病以来，饮食正常，睡眠正常，小便正常，大便正常，体重无明显变化。",
  "一般情况": "一般情况良好，神志清晰，精神好，发育正常，营养良好，自主体位，查体合作。饮食正常，睡眠正常，大小便正常，体重无明显变化。",
  "既往史": "既往病史：否认高血压、糖尿病、冠心病病史。传染病接触史：无乙肝、结核、艾滋、梅毒等传染病接触史。外伤史：无。手术史：无。输血史：无。预防接种史：随当地。过敏史：食物过敏史无，药物过敏史无。",
  "个人史": "生于原籍，无外地久居史，无疫区到访及停留史，无工业毒物、粉尘、放射性物质接触史。有吸烟史，无饮酒史。",
  "婚育史": "已婚，已育。",
  "家族史": "否认家族性遗传病史。",
  "体格检查": "T 36℃，P 95次/分，R 24次/分，BP 127/86mmHg；身高165cm，体重52kg。一般情况良好，神志清晰，精神好，发育正常，营养良好，自主体位，查体合作。全身皮肤及黏膜无黄染，未见瘀斑，无肿大浅表淋巴结。头颅无畸形；双眼无畸形，口唇红润，无唇裂。胸廓双侧对称，肺呼吸音清，未闻及干、湿性啰音。心前区无明显隆起，心尖搏动无异常，节律齐，心前区未闻及病理性杂音。腹部平坦，脾脏肋下未触及。肛门正常，外阴未查。脊柱及四肢活动好，无畸形，四肢肌张力正常。",
  "专科情况": "双耳：耳廓无畸形，外耳道无明显分泌物及新生物，鼓膜完整，解剖标志清楚，乳突区无明显红肿及压痛。鼻：外鼻无畸形，鼻前庭正常，鼻腔黏膜正常，鼻中隔无偏曲，双侧下鼻甲正常，鼻道内分泌物无，鼻道内新生物无，各鼻旁窦区无红肿压痛。咽：黏膜正常，双侧扁桃体I°，无脓栓。颈部：无抵抗感，气管居中，甲状腺未触及肿大。颈部左侧II-III区可触及8cm肿块，质地硬，活动差，为肿大淋巴结。",
  "辅助检查": "2025-04-10 巨野县人民医院：喉镜，示会厌喉面黏膜粗糙糜烂。2025-03-31 山东省肿瘤医院：病理，会厌活检考虑鳞状细胞癌，待免疫组化确诊。2025-03-25 巨野县人民医院：颈胸部增强CT，示会厌周围及左侧颈部占位性病变，双侧颈部多发肿大淋巴结，符合慢支、肺气肿、右侧肺中叶慢性炎症，双肺小结节。",
  "新辅助周期及使用药物": "术前未行新辅助治疗，无用药记录"
 },
 "病程记录 (tbl_doc_first_medical_record_post_operation)": {
  "麻醉前小结": "患者男，66岁，拟在全麻复合神经阻滞麻醉下手术。患者一般情况可，神智清，张口度、颈椎活动度大致正常，心肺（-），血压高，否认高血压病史，控制可，否认其他系统性疾病史。患者术前检查已完善，ASA分级II级，未见明显麻醉禁忌。拟行麻醉方式：静吸全麻复合神经阻滞。麻醉相关风险及可能意外和并发症已向患方讲明，表示理解，同意麻醉并在麻醉协议书上签字（详见麻醉协议书）。要求术后镇痛。",
  "麻醉后记录": "核对病人资料，监护SpO2、NBP、ECG。局麻强化下气管切开顺利，快速麻醉诱导顺利，控制通气（IPPV），静吸全麻下行手术。术中生命体征平稳，手术顺利。术毕更换气管套管，接静脉镇痛泵，送麻醉苏醒室，交班：待患者清醒，自主呼吸、肌力及保护性反射恢复，安返病房。现呼吸循环稳定，术后未见麻醉相关并发症发生。"
 },
