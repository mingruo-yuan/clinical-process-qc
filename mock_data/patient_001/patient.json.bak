  "麻醉方式": "全身麻醉",
  "麻醉医师": "赵丽云",
  "手术及操作名称": "功能性颈淋巴结清扫术+下咽成形术+颈胸腹三切口全食管切除术+下咽病损切除术+喉部分切除术+喉功能重建术"
 },
 "诊断 (tbl_dia_all_diagnoses)": {
  "出院诊断": "下咽恶性肿瘤（T2N1M0）、食管恶性肿瘤、胸腔积液、肺部感染",
  "入院诊断": "下咽恶性肿瘤、食管恶性肿瘤"
 },
 "出院记录": {
  "出院情况": "现患者术后恢复可，颈部负压引流已拔除，呼吸平稳、经口进食可，准予出院。",
  "出院医嘱": "1. 气管切开护理，保持刀口清洁；2. 建议术后8周左右行颈部放疗；3. 定期门诊复查（3月－半年），如有不适，随诊。"
 },
 "入院记录": {
  "主诉": "吞咽困难2月余。",
  "现病史": "患者2月余无明显诱因出现吞咽困难，进食后出现反流、呕吐，当时未行诊治。近3周来吞咽困难进一步加重，只能进流质饮食，饮水快时伴呛咳，伴有咳嗽、咳痰，色白质粘；近一周偶有发热。患者不伴声音嘶哑，不伴憋喘、呼吸不畅，不伴咳血、咯血。2周前就诊于枣庄市立医院，行胃镜检查示食管癌，行电子喉镜检查示下咽癌。今为求进一步治疗于我院就诊，门诊以下咽恶性肿瘤、食管恶性肿瘤收入我科。患者自发病以来，饮食差，睡眠正常，小便正常，大便正常，体重减轻8公斤。",
  "一般情况": "一般情况良好，神志清晰，精神好，发育正常，营养良好，自主体位，查体合作。饮食差，睡眠正常，大小便正常，体重减轻8公斤。",
  "既往史": "既往病史：既往无重大疾病，否认高血压、糖尿病、冠心病等基础疾病。传染病接触史：无乙肝、结核、艾滋、梅毒等传染病接触史。外伤史：无。手术史：无。输血史：无。预防接种史：随当地。过敏史：食物过敏史无，药物过敏史无。",
  "个人史": "生于原籍，无外地久居史，无疫区到访及停留史，无工业毒物、粉尘、放射性物质接触史。有吸烟史30支/天×35年，有饮酒史300g/天×30年。",
  "婚育史": "已婚，已育1子，配偶及儿子体健。",
  "家族史": "否认家族性遗传病史。",
  "体格检查": "T 35.5℃，P 65次/分，R 15次/分，BP 140/87mmHg；身高172cm，体重70kg。一般情况良好，神志清晰，精神好，发育正常，营养良好，自主体位，查体合作。全身皮肤及黏膜无黄染，未见瘀斑，无肿大浅表淋巴结。头颅无畸形；双眼无畸形，口唇红润，无唇裂。胸廓双侧对称，肺呼吸音清，未闻及干、湿性啰音。心前区无明显隆起，心尖搏动无异常，节律齐，心前区未闻及病理性杂音。腹部平坦，脾脏肋下未触及。肛门正常，外阴未查。脊柱及四肢活动好，无畸形，四肢肌张力正常。",
  "专科情况": "双耳：耳廓无畸形，外耳道无明显分泌物及新生物，鼓膜完整，解剖标志清楚，乳突区无明显红肿及压痛。鼻：外鼻无畸形，鼻前庭正常，鼻腔黏膜正常，鼻中隔无偏曲，双侧下鼻甲正常，鼻道内分泌物无，鼻道内新生物无，各鼻旁窦区无红肿压痛。咽：黏膜正常，双侧扁桃体I°，无脓栓。颈部：无抵抗感，气管居中，甲状腺未触及肿大，颈部无肿大淋巴结。",
  "辅助检查": "2024-11-28 枣庄市立医院：电子胃镜，示食管距门齿约27.5cm隆起性病变，延续至距门齿约30cm。2024-12-05 枣庄市立医院：病理，示食管距门齿30cm鳞状细胞癌。2024-12-11 山东大学齐鲁医院：电子喉镜，示右侧梨状窝内侧壁、右侧披裂外侧壁新生物隆起不平，表面大量灰白色坏死样组织。2024-12-12 山东大学齐鲁医院：病理，示右侧梨状窝鳞状细胞癌。",
  "新辅助周期及使用药物": "术前未行新辅助治疗，无用药记录"
 },
 "病程记录 (tbl_doc_first_medical_record_post_operation)": {
  "麻醉前小结": "患者李刚，男，51岁，因“吞咽困难2月余”入院。术前诊断：下咽癌、胸段食管癌。患者术前检查已完善，张口度、颈椎活动度正常，ASA分级II级，无明显麻醉禁忌。拟行麻醉方式：静吸复合全麻。麻醉相关风险已向其家属讲明，家属表示理解，同意麻醉并在麻醉协议书上签字（详见麻醉协议书）。麻醉前用药：阿托品0.5mg，术前30min肌注。",
  "麻醉后记录": "患者李刚，男，51岁，核对病人资料，监护SpO2、NBP、ECG。快诱导经口气管插管（ID7.5），控制通气（IPPV）。静吸复合下行手术。诱导过程平稳，术中生命体征平稳。术中气管切开。术毕患者拔出气管插管，换气管套管。接静脉镇痛泵，送至ICU。呼吸循环稳定，交班。术后未见麻醉相关并发症发生。"
 },
