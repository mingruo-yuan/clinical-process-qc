 "诊断 (tbl_dia_all_diagnoses)": {
  "出院诊断": "扁桃体恶性肿瘤",
  "入院诊断": "扁桃体恶性肿瘤"
 },
 "出院记录": {
  "出院情况": "患者一般情况可，生命体征平稳，神志清，精神可，未诉特殊不适。体温正常。气管套管在位通畅，分泌物不多。胃管在位。",
  "出院医嘱": "1. 气管切开护理，保持刀口清洁；2. 鼻饲流质饮食，术后2周（胸大肌修补：3周）开始经口半流质饮食；3. 建议术后1月左右放疗科就诊；4. 上臂切口出院后半月拆线；5. 1个月后复印病历，携带病历门诊复查；6. 不适随诊。"
 },
 "入院记录": {
  "主诉": "咽痛1月余，伴吞咽痛。",
  "现病史": "患者1月余前无明显诱因咽痛，伴吞咽痛，伴咽部异物感，伴吞咽阻挡感，无咳嗽、咳痰，无声嘶，无呛咳，无呼吸困难，伴平躺憋气。2025-12-18于德州市陵城区人民医院行局部切除组织活检，结果示角化型鳞状细胞癌；2025-12-24于本院行咽喉CT增强，结果示右侧软腭-腭扁桃体形态及密度异常、颈部稍大淋巴结。今为求进一步治疗于我院就诊，门诊以扁桃体恶性肿瘤收入我科。患者自发病以来，饮食正常，睡眠正常，小便正常，大便正常，体重无明显变化。",
  "一般情况": "一般情况良好，神志清晰，精神好，发育正常，营养良好，自主体位，查体合作。饮食正常，睡眠正常，大小便正常，体重无明显变化。",
  "既往史": "既往病史：腰间盘突出5年余，于当地医院行红外理疗。传染病接触史：无乙肝、结核、艾滋、梅毒等传染病接触史。外伤史：无。手术史：无。输血史：无。预防接种史：随当地。过敏史：食物过敏史无，药物过敏史无。",
  "个人史": "生于原籍，无外地久居史，无疫区到访及停留史，无工业毒物、粉尘、放射性物质接触史。有吸烟史30余年，20支/每日，已戒20余天；有饮酒史20余年，500g/每日，已戒20余天。",
  "婚育史": "已婚，已育，1子1女。",
  "家族史": "否认家族性遗传病史。",
  "体格检查": "T 35.9℃，P 74次/分，R 18次/分，BP 144/88mmHg；身高176cm，体重70kg。一般情况良好，神志清晰，精神好，发育正常，营养良好，自主体位，查体合作。全身皮肤及黏膜无黄染，未见瘀斑，无肿大浅表淋巴结。头颅无畸形；双眼无畸形，口唇红润，无唇裂。胸廓双侧对称，肺呼吸音清，未闻及干、湿性啰音。心前区无明显隆起，心尖搏动无异常，节律齐，心前区未闻及病理性杂音。腹部平坦，脾脏肋下未触及。肛门正常，外阴未查。脊柱及四肢活动好，无畸形，四肢肌张力正常。",
  "专科情况": "双耳：耳廓无畸形，外耳道无明显分泌物及新生物，鼓膜完整，解剖标志清楚，乳突区无明显红肿及压痛。鼻：外鼻无畸形，鼻前庭正常，鼻腔黏膜正常，鼻中隔无偏曲，双侧下鼻甲正常，鼻道内分泌物无，鼻道内新生物无，各鼻旁窦区无红肿压痛。咽：黏膜正常，双侧扁桃体I°，无脓栓。颈部：无抵抗感，气管居中，甲状腺未触及肿大，颈部无肿大淋巴结。",
  "辅助检查": "2025-12-18 德州市陵城区人民医院：局部切除组织活检，示角化型鳞状细胞癌。2025-12-24 山东大学齐鲁医院：咽喉CT增强，示右侧软腭-腭扁桃体形态及密度异常、颈部稍大淋巴结。",
  "新辅助周期及使用药物": "术前未行新辅助治疗，无用药记录"
 },
 "病程记录 (tbl_doc_first_medical_record_post_operation)": {
  "麻醉前小结": "患者王文武，男，57岁，因“咽痛1月余，伴吞咽痛”入院。患者术前检查已完善，张口度、颈椎活动度正常，ASA分级II级，无明显麻醉禁忌。拟行麻醉方式：静吸复合全麻加神经阻滞。麻醉相关风险已向其家属讲明，家属表示理解，同意麻醉并在麻醉协议书上签字（详见麻醉协议书）。",
  "麻醉后记录": "核对病人资料，监护SpO2、NBP、ECG。清醒状态局麻下气切置入气管插管（ID7.0），全麻诱导，控制通气（IPPV），静吸复合全麻加神经阻滞下行手术，诱导过程平稳，术中生命体征平稳，术毕更换为气切导管，待患者清醒，自主呼吸恢复满意后，Steward评分6分出室，安返病房，呼吸循环稳定，交班。术后未见麻醉相关并发症发生。"
 },
